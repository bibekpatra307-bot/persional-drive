# Database connection (PostgreSQL or Supabase connection string)
DATABASE_URL="postgresql://postgres:password@localhost:5432/private_cloud"

# Google OAuth 2.0 Credentials (for server-side Google Drive API access)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-domain.com/api/google/callback"
GOOGLE_REFRESH_TOKEN="your-google-refresh-token"

# Application Security
SESSION_SECRET="your-32-byte-random-session-secret-key"
MASTER_PASSWORD="YourStrongPrivateCloudPassword123!"

# GEMINI_API_KEY: Optional if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

